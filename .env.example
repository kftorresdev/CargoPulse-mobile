# ==============================================================================
# CargoPulse Mobile - Environment Configuration Template
# ==============================================================================

# API Base URL configuration:
# For Windows Desktop (Local debugging): http://localhost:3000/api
# For Android Emulator: http://10.0.2.2:3000/api
# For Physical Device (LAN Wi-Fi): http://192.168.1.X:3000/api
CARGOPULSE_API_BASE_URL="http://10.0.2.2:3000/api"

# Default request timeout in seconds
API_TIMEOUT_SECONDS=15

# Offline sync queue max retry count before backoff pause
MAX_SYNC_RETRIES=3

# Local SQLite Database Name
SQLITE_DB_NAME="cargopulse_local.db"
