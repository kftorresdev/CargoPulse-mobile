<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CargoPulse.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CargoPulse.Mobile.Views"
    Title="CargoPulse Mobile"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        Route="login"
        Shell.NavBarIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        Shell.TabBarIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="main">
        <Tab Title="Dashboard" Route="dashboard">
            <ShellContent
                Title="Dashboard"
                Shell.NavBarIsVisible="False"
                ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>

        <Tab Title="Escáner" Route="scanner">
            <ShellContent
                Title="Escáner"
                Shell.NavBarIsVisible="False"
                ContentTemplate="{DataTemplate views:ScannerPage}" />
        </Tab>

        <Tab Title="Embarques" Route="shipments">
            <ShellContent
                Title="Embarques"
                Shell.NavBarIsVisible="False"
                ContentTemplate="{DataTemplate views:ShipmentsListPage}" />
        </Tab>

        <Tab Title="Sincronización" Route="sync">
            <ShellContent
                Title="Sincronización"
                Shell.NavBarIsVisible="False"
                ContentTemplate="{DataTemplate views:SyncQueuePage}" />
        </Tab>
    </TabBar>

</Shell>
