    <Compile Include="..\..\src\Core\Handlers\**\*.cs" LinkBase="Core\Handlers" />
    <Compile Include="..\..\src\Data\**\*.cs" LinkBase="Data" />
    <Compile Include="..\..\src\ViewModels\**\*.cs" LinkBase="ViewModels" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui.Controls" />
  </ItemGroup>

</Project>
